<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Override the web login layout (web.login_layout)
         Replace logo and remove "Powered by Odoo" footer link
         ═══════════════════════════════════════════════════════════════ -->
    <template id="cortex_login_layout" inherit_id="web.login_layout" priority="50">

        <!-- Replace logo in login header -->
        <xpath expr="//div[hasclass('text-center') and hasclass('border-bottom')]//img" position="replace">
            <img
                src="/cortex_branding/static/src/img/cortexone_logo.png"
                alt="CortexONE"
                class="o_login_logo"
                style="max-width:220px; margin-bottom:1.5rem;"
            />
        </xpath>

        <!-- Replace "Powered by Odoo" footer link -->
        <xpath expr="//a[contains(@href,'odoo.com')]" position="replace">
            <span>CortexONE ERP</span>
        </xpath>

    </template>

    <!-- ═══════════════════════════════════════════════════════════════
         Override web.layout to set HTML title / favicon.
         NOTE: web.webclient_bootstrap has no <title>/<link> nodes, it only
         t-calls web.layout — so we must inherit web.layout directly.
         ═══════════════════════════════════════════════════════════════ -->
    <template id="cortex_webclient_title" inherit_id="web.layout" priority="50">
        <xpath expr="//title" position="replace">
            <title>CortexONE ERP</title>
        </xpath>
        <!-- Replace favicon (web.layout only has the shortcut-icon link) -->
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="shortcut icon" type="image/png"
                  href="/cortex_branding/static/src/img/cortexone_favicon.png"/>
            <link rel="icon" type="image/png"
                  href="/cortex_branding/static/src/img/cortexone_favicon.png"/>
        </xpath>
    </template>

</odoo>
