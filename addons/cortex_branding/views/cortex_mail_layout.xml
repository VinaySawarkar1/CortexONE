<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Override mail notification layout
         Replaces Odoo logo/name in email notifications
         ═══════════════════════════════════════════════════════════════ -->
    <template id="cortex_mail_notification_layout"
              inherit_id="mail.mail_notification_layout"
              priority="50">

        <!-- Replace "Powered by Odoo" footer link.
             NOTE: mail.mail_notification_layout has no logo <img> node, so we
             only override the footer link that is guaranteed to exist. -->
        <xpath expr="//a[contains(@href,'odoo.com')]" position="replace">
            <span>Powered by <a target="_blank" href="https://cortexaitechnologies.com">CortexONE</a></span>
        </xpath>

    </template>

    <!-- Portal "Powered by" branding lives in portal.portal_record_sidebar,
         not portal.portal_my_home, and portal is an optional dependency.
         Keep this override out of the base install so CI (which installs only
         cortex_branding + cortex_api) never fails on a missing parent/xpath.
         Re-enable with depends=['portal'] + inherit portal.portal_record_sidebar
         if portal branding is required. -->

</odoo>
