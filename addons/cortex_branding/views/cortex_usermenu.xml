<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Remove odoo.com links from the User Menu
         (Documentation, Support, My Odoo.com account, Shortcuts)
         ═══════════════════════════════════════════════════════════════ -->
    <template id="cortex_user_menu"
              inherit_id="web.user_menu"
              priority="50"
              optional="True">

        <!-- Remove Documentation link (links to odoo.com/documentation) -->
        <xpath expr="//a[contains(@href,'odoo.com/documentation')]" position="replace"/>

        <!-- Remove Support link -->
        <xpath expr="//a[contains(@href,'odoo.com/help')]" position="replace"/>

        <!-- Remove My Odoo.com account link -->
        <xpath expr="//a[contains(@href,'accounts.odoo.com')]" position="replace"/>

        <!-- Remove Shortcuts / keyboard shortcut promo -->
        <xpath expr="//a[@data-action='shortcuts' or contains(@class,'o_shortcuts')]"
               position="replace"/>

    </template>

</odoo>
