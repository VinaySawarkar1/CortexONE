<odoo>

    <!-- NOTE: Enterprise upsell nodes (o_settings_enterprise /
         o_enterprise_upgrade) only exist in Odoo Enterprise. Hiding them via
         xpath crashes Community installs (Element cannot be located), so this
         is intentionally done via CSS/JS instead of a view override. -->

    <!-- CortexONE section in General Settings -->
    <record id="cortex_settings_view" model="ir.ui.view">
        <field name="name">cortex.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <div class="app_settings_block" data-string="CortexONE Branding" string="CortexONE Branding">
                    <h2>CortexONE Branding</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="cortex_product_name">Product Name</label>
                                <div class="text-muted">
                                    Displayed in emails and the user interface.
                                </div>
                                <field name="cortex_product_name"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="cortex_support_email">Support Email</label>
                                <field name="cortex_support_email"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="cortex_website_url">Website URL</label>
                                <field name="cortex_website_url"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
