<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Hide Enterprise upsell section from General Settings
         ═══════════════════════════════════════════════════════════════ -->
    <record id="cortex_hide_enterprise_settings" model="ir.ui.view">
        <field name="name">cortex.hide.enterprise.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Hide Enterprise upgrade section -->
            <xpath expr="//div[contains(@class,'o_settings_enterprise')]" position="replace"/>
            <!-- Hide "Upgrade" button if present -->
            <xpath expr="//button[contains(@class,'o_enterprise_upgrade')]" position="replace"/>
        </field>
    </record>

    <!-- CortexONE section in General Settings -->
    <record id="cortex_settings_view" model="ir.ui.view">
        <field name="name">cortex.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='general_settings']" position="inside">
                <div class="app_settings_block" data-string="CortexONE Branding" string="CortexONE Branding">
                    <h2>CortexONE Branding</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="cortex_product_name">Product Name</label>
                                <div class="text-muted">
                                    Displayed in emails and the user interface.
                                </div>
                                <field name="cortex_product_name"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="cortex_support_email">Support Email</label>
                                <field name="cortex_support_email"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="cortex_website_url">Website URL</label>
                                <field name="cortex_website_url"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
