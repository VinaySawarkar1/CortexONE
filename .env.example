# CortexONE — Environment Variables Template
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# License: LGPL-3 — https://www.gnu.org/licenses/lgpl-3.0.html
# Copyright (C) 2024 Cortex AI Technologies

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=cortexone
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cortexone_prod

# ── CortexONE App ─────────────────────────────────────────────────────────────
# Master password for the database manager (make it very strong)
CORTEXONE_ADMIN_PASSWD=CHANGE_ME_MASTER_PASSWORD

# Database connection (used by the app container)
CORTEXONE_DB_HOST=postgres
CORTEXONE_DB_PORT=5432
CORTEXONE_DB_USER=cortexone
CORTEXONE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CORTEXONE_DB_NAME=cortexone_prod

# ── Email / SMTP ──────────────────────────────────────────────────────────────
CORTEXONE_SMTP_HOST=smtp.gmail.com
CORTEXONE_SMTP_PORT=587
CORTEXONE_SMTP_USER=your-email@cortexaitechnologies.com
CORTEXONE_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# ── Domain ────────────────────────────────────────────────────────────────────
# Production
CORTEXONE_DOMAIN=cortexone.cortexaitechnologies.com
# Staging
CORTEXONE_STAGE_DOMAIN=cortexonestage.cortexaitechnologies.com
